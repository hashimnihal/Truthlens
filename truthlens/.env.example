# Environment variables for TruthLens
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Development flags ─────────────────────────────────────────────────────────
# Set MOCK=1 to run without any API calls.
# Gemini returns fixture JSON; DuckDuckGo returns hard-coded results.
MOCK=0

# ── SQLite database path ──────────────────────────────────────────────────────
# Relative to the truthlens/ root. Created automatically on first run.
DB_PATH=truthlens.db

# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_SECONDS=86400

# ── Gemini model ──────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash

